# Local development example only. Do not paste this file into Railway.
# In Railway set DEBUG=false and add the required production variables below.
SECRET_KEY=replace_with_a_long_random_django_secret
DEBUG=true

# Railway provides this through a reference variable from its PostgreSQL service:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# For a Railway custom domain, set these in that service's Variables tab.
# ALLOWED_HOSTS=your-custom-domain.example
# CSRF_TRUSTED_ORIGINS=https://your-custom-domain.example
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
# SECURE_SSL_REDIRECT=true

# To retain uploaded tour/profile images on Railway, create a Volume mounted at
# /data, then set these variables in Railway:
# MEDIA_ROOT=/data/media
# SERVE_MEDIA=true

STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key
STRIPE_PUBLIC_KEY=pk_test_replace_with_your_publishable_key
# STRIPE_PUBLISHABLE_KEY is also accepted as an alias.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
STRIPE_CURRENCY=usd
